# Application
SECRET_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO

# Real-time client origins. Comma-separated.
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Optional. When set, POST /api/ml/events requires X-API-Key.
ML_API_KEY=replace-with-a-random-ingestion-key

# Optional in-memory rate limit for the ML ingestion endpoint.
ML_RATE_LIMIT=300
ML_RATE_WINDOW_SECONDS=60
